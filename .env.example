# Supabase : Project Settings → API Keys (ou `npx supabase status` en local)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique (« publishable », ou l'ancienne clé « anon ») : utilisée avec la session de l'utilisateur, soumise à la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (service_role ou « secret ») : côté serveur UNIQUEMENT, pour créer/rattacher les comptes.
SUPABASE_SERVICE_ROLE_KEY=

# Adresse e-mail du coach : à la première connexion avec cette adresse, le profil coach est créé
# (ou le profil coach existant sans compte lui est rattaché).
COACH_EMAIL=
# Nom affiché du coach lors de la création automatique (optionnel)
COACH_NAME=

# Assistant IA (optionnel) : clé API Anthropic (console.anthropic.com). Sans clé, le bouton IA est masqué.
ANTHROPIC_API_KEY=
